{
  "info": {
    "name": "Zumma Web Automation API",
    "_postman_id": "8f2c1b4e-2b4a-4d7c-9f3e-1a2b3c4d5e6f",
    "description": "Coleccion completa de la Web Automation API.\n\nFlujo recomendado:\n1. `Health` para verificar que la API, Postgres y Redis responden.\n2. `Saucedemo` o `Practice Software Testing`: el POST guarda el `job_id` en una variable de coleccion y el GET siguiente poll-ea hasta que el job termina.\n3. `Errores` cubre los casos de validacion y 404.\n\nEjecutable completo desde la UI (Run collection) o por CLI:\n\n    newman run postman/zumma-web-automation.postman_collection.json \\\n      -e postman/local.postman_environment.json --delay-request 3000\n\n`--delay-request` es lo que espacia los reintentos del polling.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "job_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "poll_attempt",
      "value": "0",
      "type": "string"
    },
    {
      "key": "max_poll_attempts",
      "value": "60",
      "type": "string"
    },
    {
      "key": "image_url",
      "value": "",
      "type": "string"
    },
    {
      "key": "lookup_key",
      "value": "hammer",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET / (service info)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('expone docs y health', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('docs');",
                  "  pm.expect(body).to.have.property('health');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('postgres accesible', () => pm.expect(body.database).to.eql('ok'));",
                  "pm.test('redis accesible', () => pm.expect(body.queue).to.eql('ok'));",
                  "pm.test('estado general ok', () => pm.expect(body.status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Saucedemo",
      "item": [
        {
          "name": "POST /tasks (saucedemo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"saucedemo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "Inicia el scraping de saucedemo (incluye login). Responde 202 con el job_id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('devuelve un job_id con formato UUID', function () {",
                  "  pm.expect(body).to.have.property('job_id');",
                  "  pm.expect(body.job_id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "});",
                  "",
                  "// El job_id queda disponible para el request de polling que sigue.",
                  "pm.collectionVariables.set('job_id', body.job_id);",
                  "pm.collectionVariables.set('poll_attempt', '0');"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /tasks/{{job_id}} (poll hasta completar)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks/{{job_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "{{job_id}}"
              ]
            },
            "description": "Se reejecuta solo mientras el job este en pending/in_progress. Usar `--delay-request 3000` en newman para espaciar los reintentos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "const attempt = Number(pm.collectionVariables.get('poll_attempt')) + 1;",
                  "const maxAttempts = Number(pm.collectionVariables.get('max_poll_attempts'));",
                  "pm.collectionVariables.set('poll_attempt', String(attempt));",
                  "",
                  "pm.test('status es uno de los cuatro estados validos', function () {",
                  "  pm.expect(body.status).to.be.oneOf(['pending', 'in_progress', 'completed', 'failed']);",
                  "});",
                  "",
                  "if (body.status === 'pending' || body.status === 'in_progress') {",
                  "  pm.test('respuesta no terminal no trae data', () => pm.expect(body).to.not.have.property('data'));",
                  "  if (attempt < maxAttempts) {",
                  "    console.log('job ' + body.status + ', reintento ' + attempt + '/' + maxAttempts);",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "  } else {",
                  "    pm.test('el job termino dentro del limite de reintentos', () => pm.expect.fail('timeout tras ' + maxAttempts + ' intentos'));",
                  "  }",
                  "} else if (body.status === 'failed') {",
                  "  pm.test('un job fallido explica el error', function () {",
                  "    pm.expect(body).to.have.property('error_message');",
                  "    pm.expect(body.error_message).to.be.a('string').and.not.empty;",
                  "  });",
                  "} else {",
                  "  pm.test('un job completado trae productos', function () {",
                  "    pm.expect(body.data).to.be.an('array').that.is.not.empty;",
                  "  });",
                  "",
                  "  pm.test('cada producto respeta el contrato del challenge', function () {",
                  "    body.data.forEach(function (product) {",
                  "      pm.expect(product, JSON.stringify(product)).to.have.all.keys('name', 'price', 'description', 'image_url');",
                  "      pm.expect(product.name).to.be.a('string').and.not.empty;",
                  "      pm.expect(product.price).to.be.a('string').and.not.empty;",
                  "      pm.expect(product.description).to.be.a('string');",
                  "    });",
                  "  });",
                  "",
                  "  pm.test('image_url es una URL absoluta de este backend', function () {",
                  "    const base = pm.variables.replaceIn('{{baseUrl}}');",
                  "    body.data.forEach(function (product) {",
                  "      pm.expect(product.image_url).to.be.a('string').and.include(base + '/images/');",
                  "    });",
                  "  });",
                  "",
                  "  pm.test('el precio tiene formato monetario', function () {",
                  "    body.data.forEach(function (product) {",
                  "      pm.expect(product.price, product.name).to.match(/\\d/);",
                  "    });",
                  "  });",
                  "",
                  "  pm.collectionVariables.set('image_url', body.data[0].image_url);",
                  "  console.log('job completado con ' + body.data.length + ' productos');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET image_url (la imagen la sirve el backend)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{image_url}}",
              "host": [
                "{{image_url}}"
              ]
            },
            "description": "Comprueba que la URL devuelta en image_url efectivamente sirve la imagen descargada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('el Content-Type es una imagen', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('image/');",
                  "});",
                  "pm.test('el archivo no esta vacio', () => pm.expect(pm.response.responseSize).to.be.above(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Practice Software Testing",
      "item": [
        {
          "name": "POST /tasks (practicesoftware + lookup_key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"practicesoftware\",\n  \"lookup_key\": \"hammer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "lookup_key filtra por coincidencia parcial en el nombre del producto."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('job_id', body.job_id);",
                  "pm.collectionVariables.set('poll_attempt', '0');",
                  "pm.collectionVariables.set('lookup_key', 'hammer');"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /tasks/{{job_id}} (poll y verifica el filtro)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks/{{job_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "{{job_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "const attempt = Number(pm.collectionVariables.get('poll_attempt')) + 1;",
                  "const maxAttempts = Number(pm.collectionVariables.get('max_poll_attempts'));",
                  "pm.collectionVariables.set('poll_attempt', String(attempt));",
                  "",
                  "if (body.status === 'pending' || body.status === 'in_progress') {",
                  "  if (attempt < maxAttempts) {",
                  "    console.log('job ' + body.status + ', reintento ' + attempt + '/' + maxAttempts);",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "  } else {",
                  "    pm.test('el job termino dentro del limite de reintentos', () => pm.expect.fail('timeout tras ' + maxAttempts + ' intentos'));",
                  "  }",
                  "} else if (body.status === 'failed') {",
                  "  pm.test('un job fallido explica el error', () => pm.expect(body.error_message).to.be.a('string').and.not.empty);",
                  "} else {",
                  "  const lookupKey = pm.collectionVariables.get('lookup_key').toLowerCase();",
                  "  pm.test('devuelve productos', () => pm.expect(body.data).to.be.an('array').that.is.not.empty);",
                  "  pm.test('todos los productos matchean el lookup_key', function () {",
                  "    body.data.forEach(function (product) {",
                  "      pm.expect(product.name.toLowerCase()).to.include(lookupKey);",
                  "    });",
                  "  });",
                  "  pm.test('image_url apunta a este backend', function () {",
                  "    const base = pm.variables.replaceIn('{{baseUrl}}');",
                  "    body.data.forEach((product) => pm.expect(product.image_url).to.include(base + '/images/'));",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Errores",
      "item": [
        {
          "name": "POST /tasks con task_id desconocido -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"mercadolibre\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "task_id esta tipado como enum, asi que Pydantic lo rechaza con 422 y lista los valores validos. Antes esto provocaba un 500."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable Entity (no 500)', () => pm.response.to.have.status(422));",
                  "pm.test('el error menciona los task_id validos', function () {",
                  "  pm.expect(JSON.stringify(pm.response.json())).to.include('saucedemo');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /tasks con campo desconocido -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
